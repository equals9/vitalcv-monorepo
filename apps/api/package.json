{
  "name": "@vitalcv/api",
  "version": "1.0.0",
  "description": "End-to-end healthcare credentialing and hiring verification.",
  "main": "index.js",
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "typecheck": "bash ../../scripts/prisma-generate-locked.sh --schema backend/prisma/schema.prisma && pnpm exec tsc -p backend/tsconfig.json --noEmit",
    "build": "bash ../../scripts/prisma-generate-locked.sh --schema backend/prisma/schema.prisma && pnpm exec tsc -p backend/tsconfig.json",
    "start": "npm --prefix backend run start",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy --schema backend/prisma/schema.prisma",
    "qa:ci": "npm --prefix backend run qa:ci",
    "graph:bench": "npm --prefix backend run graph:bench",
    "seed": "npm --prefix backend run seed",
    "watchtower": "pnpm exec ts-node backend/src/tools/watchtower.ts",
    "test": "npm --prefix backend test",
    "test:did": "node --test backend/__tests__/cross_chain_did_resolver.test.js"
  },
  "turbo": {
    "build": {
      "outputs": [
        "backend/dist/**"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/swagger-ui-express": "^4.1.8",
    "ethers": "^5.8.0",
    "hardhat": "^2.25.0",
    "prisma": "^6.19.2",
    "solc": "^0.8.36",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.6.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@prisma/client": "^6.19.2",
    "@sentry/node": "^10.69.0",
    "@simplewebauthn/server": "^9.0.0",
    "@vitalcv/audit": "workspace:*",
    "@vitalcv/command-registry": "workspace:*",
    "@vitalcv/crs": "workspace:*",
    "@vitalcv/domain": "workspace:*",
    "@vitalcv/domain-core": "workspace:*",
    "@vitalcv/domain-events": "workspace:*",
    "@vitalcv/haip-config": "workspace:*",
    "@vitalcv/ingest": "workspace:*",
    "@vitalcv/poe-engine": "workspace:*",
    "@vitalcv/psv": "workspace:*",
    "@vitalcv/psv-adapters": "workspace:*",
    "@vitalcv/shared": "workspace:*",
    "@vitalcv/trust-state": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3",
    "@trustgraph/client": "^1.7.2"
  }
}