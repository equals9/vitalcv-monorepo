{
  "name": "chai-vc-platform-backend",
  "version": "1.0.0",
  "description": "chai vc platform backend",
  "main": "dist/apps/api/backend/src/server.js",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "db:migrate:deploy": "pnpm exec prisma migrate deploy",
    "dev": "bash ../../../scripts/prisma-generate-locked.sh --schema prisma/schema.prisma && ts-node src/server.ts",
    "build": "bash ../../../scripts/prisma-generate-locked.sh --schema prisma/schema.prisma && tsc",
    "qa:ci": "pnpm exec ts-node src/qa/runQaSuite.ts",
    "graph:bench": "pnpm exec ts-node src/tools/graphBench.ts",
    "manual:audit-bundle": "pnpm exec ts-node src/tools/generateManualAuditBundle.ts",
    "ncqa:validate": "pnpm exec ts-node src/tools/runNcqaValidationGate.ts",
    "start": "node -r ./register-workspace-paths.js dist/apps/api/backend/src/server.js",
    "test": "bash ../../../scripts/backend-test-db.sh",
    "test:scale": "DATABASE_URL=${DATABASE_URL:-postgresql://scale-mock@localhost:5432/scale-mock} jest --testPathPattern='__tests__/scale/' --runInBand --no-coverage",
    "seed": "pnpm exec prisma migrate deploy && ts-node -P tsconfig.seed.json prisma/seed.ts",
    "seed:opportunities": "ts-node -P tsconfig.seed.json prisma/seed-opportunities.ts",
    "seed:demo-accounts": "ts-node -P tsconfig.seed.json prisma/seed-demo-accounts.ts",
    "prisma:generate": "bash ../../../scripts/prisma-generate-locked.sh --schema prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@polkadot/api": "^16.5.6",
    "@polkadot/keyring": "^14.0.3",
    "@prisma/client": "^6.19.2",
    "@sd-jwt/decode": "^0.19.0",
    "@types/cheerio": "^1.0.0",
    "@types/multer": "^2.2.0",
    "@types/supercluster": "^7.1.3",
    "@vitalcv/audit": "workspace:*",
    "@vitalcv/command-registry": "workspace:*",
    "@vitalcv/crs": "workspace:*",
    "@vitalcv/domain": "workspace:*",
    "@vitalcv/domain-common": "workspace:*",
    "@vitalcv/domain-core": "workspace:*",
    "@vitalcv/domain-events": "workspace:*",
    "@vitalcv/haip-config": "workspace:*",
    "@vitalcv/ingest": "workspace:*",
    "@vitalcv/poe-engine": "workspace:*",
    "@vitalcv/psv": "workspace:*",
    "@vitalcv/psv-adapters": "workspace:*",
    "@vitalcv/shared": "workspace:*",
    "@vitalcv/trust-state": "workspace:*",
    "apollo-server": "^3.13.0",
    "apollo-server-express": "^3.12.2",
    "archiver": "^7.0.1",
    "cheerio": "^1.1.2",
    "did-resolver": "^4.1.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.15.0",
    "ethr-did-resolver": "^14.1.0",
    "express": "^4.19.2",
    "express-validator": "^7.3.2",
    "jose": "^5.10.0",
    "key-did-resolver": "^4.0.0",
    "lru-cache": "^10.4.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.2",
    "stripe": "^20.4.0",
    "supercluster": "^7.1.3",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "web-did-resolver": "^2.0.30"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.0.0",
    "jsonwebtoken": "^9.0.2",
    "openapi-types": "^12.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.8.3"
  }
}
