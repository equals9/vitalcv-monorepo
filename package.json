{
  "name": "vitalcv",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build:web": "pnpm turbo run build --filter @vitalcv/web",
    "build:web:direct": "pnpm --filter @vitalcv/trust-state build && pnpm --filter @vitalcv/web build",
    "build:check-chain": "bash scripts/check-web-build-chain.sh",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo build && turbo test --only --filter='!@vitalcv/api' --filter='!chai-vc-platform-backend' && bash scripts/backend-test-db.sh --silent",
    "build": "pnpm turbo build",
    "check:deploy": "node --experimental-strip-types scripts/deployment-integrity-check.ts",
    "check:claims": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-public-claims.ts",
    "check:copy": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-copy-rules.ts",
    "check:design-md": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-design-md.ts --check",
    "check:design": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-design-lint.ts",
    "check:routes": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-route-guards.ts",
    "check:canonical-source-adapters": "node scripts/check-canonical-source-adapter-imports.mjs",
    "verify:release": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/release-monitor/register-ts-resolver.mjs scripts/release-verify.ts",
    "reconcile:synthetics": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/release-monitor/register-ts-resolver.mjs scripts/reconcile-synthetics.ts",
    "report:public-copy": "node scripts/report-public-entry-copy-sources.js",
    "audit:active-routes": "node scripts/audit-active-routes.mjs",
    "test:backend:db": "bash scripts/backend-test-db.sh",
    "verify:production-convergence": "node --experimental-strip-types scripts/runtime/verify-production-convergence.ts",
    "verify:passport-runtime": "node --experimental-strip-types scripts/runtime/verify-passport-runtime.ts",
    "release:readiness": "node --experimental-strip-types scripts/release/release-readiness.ts",
    "runtime:kill-shadow-runtimes": "bash scripts/runtime/kill-shadow-runtimes.sh",
    "smoke:deploy": "node scripts/deploy-smoke.mjs",
    "check:workflow-contract": "node scripts/check-workflow-path-filters.js",
    "check:workflow-contract:protection": "node scripts/check-workflow-path-filters.js --verify-protection"
  },
  "devDependencies": {
    "@types/node": "^20",
    "next": "15.5.22",
    "turbo": "^2.10.12",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": []
    },
    "overrides": {
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "cheerio>undici": "^7.28.0",
      "handlebars": "^4.7.9",
      "protobufjs": "^7.5.5",
      "shell-quote": "^1.8.4"
    }
  }
}
